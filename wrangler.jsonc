{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonicrelay",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "sonicrelay.hugodotnet.dev",
      "custom_domain": true
    }
  ]
}
